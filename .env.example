# Copy this file to ".env" to change settings. Everything is optional.

# Port the theatre runs on.
# PORT=4747

# Where prepared movies are stored (they can be large).
# MEDIA_DIR=/Volumes/BigDisk/villavision-media

# Your fixed public address. "npm run tunnel:setup" fills this in for you.
# PUBLIC_URL=https://movies.example.com

# Voice, webcams and screen sharing connect viewers directly. If someone on a
# strict network can't be seen or heard, add a TURN relay here.
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Largest movie file the host page accepts, in GB.
# MAX_UPLOAD_GB=50

# Advanced: only if you run this on a remote server instead of your own
# computer. Lets the host page work from other machines (protected by the host
# key alone), and makes the server listen on all network interfaces.
# ALLOW_REMOTE_HOST=1
# HOST=0.0.0.0
